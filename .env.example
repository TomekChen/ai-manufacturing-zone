# 智能制造专区 - 环境变量模板（复制为 .env 后填写真实值）

# 宿主机映射端口
HOST_PORT=8804

# 管理员账号
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123

# Flask 密钥（生产环境务必改成随机字符串）
SECRET_KEY=change-me-in-production

# 阿里云百炼（DashScope）API Key，用于知识库嵌入(text-embedding-v3)与问答(qwen-plus)
# 获取地址：https://bailian.console.aliyun.com/ -> API-KEY 管理
DASHSCOPE_API_KEY=
